# ---------------------------------------------------------------------------
# Jarvis configuration. Copy to `.env` and fill in. NEVER commit a real `.env`.
# The core runtime works with NONE of these set (it degrades gracefully).
# Secrets are read from the environment at runtime and are never written to
# source code, memory, or the audit log (they are redacted on the way in).
# ---------------------------------------------------------------------------

# Where Jarvis keeps memory, audit log, knowledge base and task checkpoints.
# Default: ~/.jarvis
# JARVIS_HOME=/home/you/.jarvis

# --- Autonomy: how much the agent may do without asking ----------------------
# auto   = LOW risk actions run silently; MEDIUM asks; HIGH/CRITICAL always ask
# ask    = every action asks first
# review = LOW+MEDIUM run; HIGH/CRITICAL ask
JARVIS_AUTONOMY=auto

# Default jurisdiction for compliance lookups (ISO-3166-1 alpha-2).
JARVIS_JURISDICTION=IN

# Response language policy: match | en | hi | hinglish
JARVIS_LANGUAGE_POLICY=match

# --- Optional model providers (all optional; Jarvis runs without any) --------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=

# Which provider the router should prefer when it has a choice.
# JARVIS_MODEL_PROVIDER=auto

# --- Safety switches ---------------------------------------------------------
# Hard kill-switch for anything that touches the OS / other applications.
JARVIS_COMPUTER_USE=off
# camera | mic | screen  (comma separated list of granted capture devices)
JARVIS_CAPTURE_DEVICES=
# Enable the always-active background loop (Phase 9). Default off.
JARVIS_ALWAYS_ACTIVE=off

# --- Live research (Phase 2) --------------------------------------------------
# Off by default. When on, Jarvis may retrieve a URL you give it: it honours
# robots.txt, refuses internal/private addresses, never works around an access
# restriction, and only stores what passes the knowledge base's gates.
JARVIS_FETCH=off

# --- Storage backends (optional; default is local SQLite + JSONL) ------------
# JARVIS_DATABASE_URL=postgresql://user:pass@localhost:5432/jarvis
# JARVIS_REDIS_URL=redis://localhost:6379/0
