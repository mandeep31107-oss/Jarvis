# ---------------------------------------------------------------------------
# J.A.R.V.I.S. environment configuration
# Copy this file to ".env" and fill in values. NEVER commit ".env".
# Windows PowerShell:  Copy-Item .env.example .env
# ---------------------------------------------------------------------------

# development | production
NODE_ENV=development

# HTTP port. The server binds 0.0.0.0 so it works in containers/previews.
PORT=5173

# Where the SQLite database and local artifacts live (relative to repo root).
DATA_DIR=data

# REQUIRED in production: long random string used to sign session cookies.
# Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# If unset in development, a random secret is generated per boot (sessions are
# invalidated on restart). Production refuses to boot without it.
SESSION_SECRET=

# Session lifetime in hours.
SESSION_TTL_HOURS=168

# ---------------------------------------------------------------------------
# AI provider
# offline  = no network, deterministic local responder (clearly labelled)
# openai   = any OpenAI-compatible /chat/completions endpoint
#            (OpenAI, Groq, Together, OpenRouter, vLLM, LM Studio ...)
# ollama   = local Ollama server (OpenAI-compatible endpoint)
# ---------------------------------------------------------------------------
AI_PROVIDER=offline
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_TIMEOUT_MS=45000
AI_MAX_OUTPUT_TOKENS=900

# Approximate price per 1M tokens, used only for cost *estimates* on the
# dashboard. Set these to your provider's current published prices.
AI_PRICE_INPUT_PER_MTOK=0.15
AI_PRICE_OUTPUT_PER_MTOK=0.60

# ---------------------------------------------------------------------------
# Safety / autonomy
# ---------------------------------------------------------------------------
# 1 = suggest only, 2 = approved execution (default), 3 = bounded automation
AUTONOMY_LEVEL=2

# Research tool: allow outbound HTTP(S) fetches from the server.
# When false, the research agent reports that it cannot reach the network.
ALLOW_OUTBOUND_FETCH=false

# Optional comma separated allowlist of hostnames the research tool may fetch.
# Empty = any public host (private/loopback addresses are always blocked).
RESEARCH_ALLOWED_HOSTS=

# Wake phrase used by the browser voice interface (stored server-side so all
# devices share it). Changing it here is only a default for a fresh install.
WAKE_PHRASE=jarvis

# ---------------------------------------------------------------------------
# Sign-in: email and mobile one-time codes
# ---------------------------------------------------------------------------
# 6-digit codes live for OTP_TTL_SECONDS and die after OTP_MAX_ATTEMPTS wrong
# tries. At most 3 codes are issued per identifier per 15 minutes, and at most
# AUTH_RATE_LIMIT auth requests per IP per 15 minutes.
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT=20

# Numbers typed without a country code are assumed to be from this country.
DEFAULT_COUNTRY_CODE=+91

# Email codes.
#   console = DEVELOPMENT ONLY: the code is written to the server log and shown
#             on screen. Nothing is emailed. Production refuses to use it.
#   smtp    = real delivery. For Gmail you MUST use an App Password
#             (https://myaccount.google.com/apppasswords); your normal Google
#             password will be rejected. SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
#             SMTP_SECURE=false.
MAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Mobile codes.
#   console = DEVELOPMENT ONLY: the code is logged and shown on screen.
#   twilio  = real SMS. The Twilio "from" number must be E.164, e.g. +12025550123.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
